# CORTEX-PRIME Environment Configuration
# Copy to .env and update with your values

# ===============================
# API SERVER CONFIGURATION
# ===============================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# ===============================
# DATABASE
# ===============================
DATABASE_URL=sqlite:///./cortex_prime.db
DATABASE_ECHO=False

# ===============================
# PATHS (Must be absolute or relative to backend/)
# ===============================
VAULT_ROOT=./vault
LOGS_DIR=./logs
SCRIPTS_DIR=./scripts

# ===============================
# JWT AUTHENTICATION
# ===============================
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===============================
# GEMINI API (Free tier: 1M tokens/day)
# Get key at: https://aistudio.google.com
# ===============================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# ===============================
# SYNC & SEMANTIC SEARCH
# ===============================
EMBEDDINGS_CACHE_PATH=./logs/embeddings_cache.json
SYNERGY_SIMILARITY_THRESHOLD=0.75

# ===============================
# ANKI CONNECT (Optional)
# ===============================
ANKI_CONNECT_URL=http://localhost:8765
ANKI_DEFAULT_DECK=CORTEX-PRIME

# ===============================
# BURNOUT MONITORING
# ===============================
BURNOUT_DEEPWORK_THRESHOLD=0.4
BURNOUT_CHECK_DAYS=3

# ===============================
# FRONTEND CONFIGURATION
# ===============================
VITE_API_URL=http://localhost:8000
VITE_APP_VERSION=1.0.0
VITE_DEBUG=true
